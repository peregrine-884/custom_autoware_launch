<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="joy_device_id" default="0"/>
  <arg name="can_port"/>
  <arg name="is_scout_mini"/>
  <arg name="controller_param_file" default="$(find-pkg-share common_agilex_vehicle)/config/manual_control.param.yaml"/>
  <arg name="interface_param_file" default="$(find-pkg-share common_agilex_vehicle)/config/vehicle_interface.param.yaml"/>

  <node pkg="joy" exec="joy_node" name="joy_node" output="screen">
    <param name="device_id" value="$(var joy_device_id)"/>
    <param name="deadzone" value="0.05"/>
    <param name="autorepeat_rate" value="20.0"/>
  </node>

  <node pkg="common_agilex_vehicle" exec="agilex_joy_controller"
        name="agilex_joy_controller" output="screen">
    <param from="$(var controller_param_file)"/>
  </node>

  <node pkg="common_agilex_vehicle" exec="agilex_vehicle_interface"
        name="agilex_vehicle_interface" output="screen">
    <param from="$(var interface_param_file)"/>
  </node>

  <include file="$(find-pkg-share scout_base)/launch/scout_base.launch.py">
    <arg name="port_name" value="$(var can_port)"/>
    <arg name="is_scout_mini" value="$(var is_scout_mini)"/>
  </include>
</launch>
