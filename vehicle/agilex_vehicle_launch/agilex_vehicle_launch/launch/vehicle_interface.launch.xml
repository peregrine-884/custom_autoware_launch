<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="vehicle_id" default="$(env VEHICLE_ID default)"/>
  <arg name="joy_device_id" default="0"/>
  <arg name="can_port" default="can2"/>
  <arg name="is_scout_mini" default="true"/>
  <arg name="vehicle_interface_param_file" default="$(find-pkg-share common_agilex_vehicle)/config/vehicle_interface.param.yaml"/>
  <arg name="controller_param_file" default="$(find-pkg-share common_agilex_vehicle)/config/manual_control.param.yaml"/>

  <include file="$(find-pkg-share common_agilex_vehicle)/launch/vehicle_interface.launch.xml">
    <arg name="joy_device_id" value="$(var joy_device_id)"/>
    <arg name="can_port" value="$(var can_port)"/>
    <arg name="is_scout_mini" value="$(var is_scout_mini)"/>
    <arg name="controller_param_file" value="$(var controller_param_file)"/>
    <arg name="interface_param_file" value="$(var vehicle_interface_param_file)"/>
  </include>
</launch>
